# Firebase Config (Automatically handled by AI Studio for the applet)
# VITE_FIREBASE_CONFIG=

# Email Settings (Resend)
RESEND_API_KEY=

# Google Drive Settings (Server-side automated backup)
# Option 1: Use Oauth Refresh Token (Developer authorizes once)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option 2: Use Service Account (Recommended for automated tasks)
# Paste the entire JSON content from your service account key file
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# Optional: Fixed folder ID for backups
GOOGLE_DRIVE_FOLDER_ID=
